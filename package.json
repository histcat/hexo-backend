{
  "name": "hexo-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "tsx watch server/dev.ts",
    "build": "npm run build:client",
    "build:client": "cd client && npm install && npm run build",
    "typecheck": "tsc",
    "deploy": "npm run build && vercel --prod"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "jose": "^5.10.0",
    "js-yaml": "^5.2.3"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vercel": "^39.1.1"
  }
}
